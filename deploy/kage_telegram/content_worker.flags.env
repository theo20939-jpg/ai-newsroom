# KAGE Telegram content_worker - committed release behaviour flags (NO secrets here).
# The deployed worker env is built by scripts/kage_build_worker_env.py: host secrets/connection
# values + these flags, flags always winning, every key exactly once. This file, not a
# docker-compose override, shell inheritance or a developer machine, defines release behaviour.

# Autonomy stays under explicit founder control.
CONTENT_GENERATION_ENABLED=false
CONTENT_GENERATION_DRY_RUN=false

# Accepted KAGE 11.10 stack and route.
COPYWRITING_PROMPT_VERSION=11.10
EDITORIAL_DELIVERY_MODE=router
NEWSROOM_TELEGRAM_CHAT_ID=-1004297182444
NEWS_TOPIC_ID=2

# Infrastructure.
REDIS_HOST=redis
POSTGRES_HOST=postgres

# Media runtime. The unified editorial pipeline is explicitly OFF in this release: it adds no
# image recovery or generation for KAGE NEWS today (null web discovery, no recovery consumer,
# no generation tier) and has not been validated with the KAGE 11.10 publication path. The legacy
# router path HOLDS a story with no usable visual (VISUAL_HOLD) and bills its one visual call
# (Gemini recomposition) inside the per-story envelope. Enabling it is a one-line founder decision.
UNIFIED_EDITORIAL_PIPELINE_ENABLED=false
PULSE_BRAND_ENABLED=true
EDITORIAL_RECOMPOSITION_MODE=live
IMAGE_INTELLIGENCE_MODE=shadow
VIDEO_DISCOVERY_MODE=enforce

# Lanes that must stay off for the Telegram release.
INSTAGRAM_AUTOMATIC_GENERATION_ENABLED=false
INSTAGRAM_PRODUCT_LANE_ENABLED=false
MEME_OPPORTUNITY_MODE=off
