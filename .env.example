# Application
APP_NAME=AI Newsroom
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_newsroom
# Phase 23.1L: dedicated pytest database, physically separate from POSTGRES_DB above - every
# integration test connects here, never to POSTGRES_DB (docs/
# phase23_1l_runtime_isolation_final_canary_report.md). Create it once with
# `CREATE DATABASE ai_newsroom_test;` then `POSTGRES_DB=ai_newsroom_test alembic upgrade head`.
POSTGRES_TEST_DB=ai_newsroom_test

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Telegram Bot API (bot/, aiogram, Phase 3) - required to run: python -m bot.main
# Obtained from @BotFather in Telegram.
TELEGRAM_BOT_TOKEN=

# Telegram Client API (Telethon, Source Collector, Phase 4) - required to run:
# python -m scripts.run_collector
# TELEGRAM_API_ID / TELEGRAM_API_HASH are obtained from https://my.telegram.org.
# TELEGRAM_SESSION_STRING is generated once, manually, via an interactive Telethon
# login (see README "Telegram Client credentials") - never a .session file.
# Fully separate from TELEGRAM_BOT_TOKEN above; not used by bot/.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=

# GitHub REST API (integrations/sources/github_source.py, Source Collector, Phase 4.2)
# Optional - the GitHub API works unauthenticated too, just at 60 req/hr instead of
# 5000 req/hr. Required for the pack's github_api sources to be imported at all
# (see services/adapter_keys.py and the auth-gating rule in services/source_pack_importer.py).
# Generate a classic or fine-grained personal access token at https://github.com/settings/tokens
# - no scopes are needed, this only reads public repository releases.
GITHUB_TOKEN=

# AI Layer - reserved for a future phase, not implemented yet.
# Optional; no functionality depends on them at this stage.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MAX_DAILY_AI_COST=
MAX_MONTHLY_AI_COST=

# Phase 7 AI Integration Layer (docs/phase7_architecture_contract.md).
# ENABLED_PROVIDERS gates which providers actually go live at boot (§2 rule 2,
# §17.1, §20.1) - a JSON array of provider_id strings, e.g. ENABLED_PROVIDERS=["openai"].
# Empty by default: OPENAI_API_KEY alone does not put OpenAI live.
ENABLED_PROVIDERS=[]
# Opt-in, boot-time-only CapabilityNegotiator verification pass (§17.3) - not
# implemented yet in this delivery; left here, default "off", for forward compatibility.
VERIFY_CAPABILITIES_AT_BOOT=false
# §28 Q1 (Pending Ratification) - fail_open or fail_closed behavior for RateLimiter and
# the real CostTracker ledger on Redis unavailability. Deliberately has NO default: the
# contract's own binding provisional rule requires those components to raise a boot-time
# configuration error, not silently pick one, until this is explicitly set. One of:
# fail_open | fail_closed
REDIS_UNAVAILABLE_POLICY=

# Phase 9 Triage Orchestrator (docs/phase9_research_intelligence_architecture_contract.md
# §7.6/§22). Seconds a claimed-but-abandoned NewsEvent must remain PROCESSING with no
# active task before it becomes a stale-recovery candidate. MUST be a positive integer -
# 0 or a negative value fails Settings construction at process startup rather than
# silently disabling stale-recovery protection. Default: 900 (15 minutes).
STALE_PROCESSING_THRESHOLD_SECONDS=900
